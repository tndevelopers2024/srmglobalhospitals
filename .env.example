# Copy to .env.local for local development, and set these in your host's
# environment settings for production. Never commit real values.

# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph tags,
# the sitemap and robots.txt. On Vercel this is inferred from the deployment,
# but set it explicitly in production so previews still emit prod canonicals.
NEXT_PUBLIC_SITE_URL=https://srmglobalhospitals.com

# Google Search Console verification token (the content value of the
# `google-site-verification` meta tag). Leave unset until the property is
# claimed — the meta tag is omitted when this is empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
